{
  "name": "howtox",
  "version": "0.2.0",
  "private": true,
  "description": "Config-driven whitelabel site platform: marketing, appointments, and interactive-experience marketplaces from one codebase",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
